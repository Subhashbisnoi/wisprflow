# Copy to .env and fill in. Never commit .env.

# Postgres. Either name works; postgresql:// is normalised to the psycopg driver.
DB_URL=postgresql://user:password@localhost:5432/ledgerline
# DATABASE_URL=postgresql://user:password@localhost:5432/ledgerline

# OpenAI (required unless LLM_PROVIDER=fake)
OPENAI_API_KEY=sk-...
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_VISION_MODEL=gpt-4.1
# OPENAI_TIMEOUT_SECONDS=60
# LLM_PROVIDER=openai          # or "fake" for offline development

# Auth. Required outside development (a random secret is generated in dev).
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=480

# App
# APP_ENV=development          # development | test | production
# LOG_LEVEL=INFO
# STORAGE_DIR=./backend/storage
# MAX_UPLOAD_MB=15
# MAX_FILES_PER_UPLOAD=20
# EXTRACTION_WORKERS=3
# EXTRACTION_MAX_ATTEMPTS=3
# CORS_ORIGINS=http://localhost:5173
# STORAGE_BACKEND=local        # or "database" on serverless hosts (Vercel)
# JOB_QUEUE_BACKEND=in_process # or "sync" on serverless hosts (Vercel)
# DB_POOL_SIZE=10

# Tests only: a SEPARATE database that the test-suite drops and recreates.
# TEST_DATABASE_URL=postgresql://localhost/ledgerline_test
