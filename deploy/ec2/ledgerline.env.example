# Production settings for the Ledgerline API on EC2.
# setup.sh copies this to /etc/ledgerline/ledgerline.env (owner root, group ledgerline,
# mode 640) and fills in JWT_SECRET. Edit it there; never commit real values.
# Format: plain KEY=value lines (systemd EnvironmentFile). No "export", and no spaces
# around "=".

APP_ENV=production
LOG_LEVEL=INFO

# Local port Uvicorn listens on behind Nginx (used by setup.sh/deploy.sh).
LEDGERLINE_PORT=8001

# --- Required -------------------------------------------------------------------------
# Postgres. Keep sslmode=require for a database on another host.
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
OPENAI_API_KEY=sk-...
# Generated by setup.sh. Changing it signs everyone out.
JWT_SECRET=__GENERATED_BY_SETUP__

# Browser origins allowed to call the API (comma separated), e.g. the Vercel frontend.
CORS_ORIGINS=https://wisprflow-eta.vercel.app

# --- Storage and background work (EC2 defaults) ---------------------------------------
# Documents on the instance's EBS volume. Snapshot the volume, or switch to
# STORAGE_BACKEND=database to keep documents in Postgres with everything else.
STORAGE_BACKEND=local
STORAGE_DIR=/var/lib/ledgerline/storage
# Real background workers; pending bills are re-queued automatically on restart.
JOB_QUEUE_BACKEND=in_process
# 2 suits a 1 GB instance; raise to 3-4 with 2 GB+ of RAM.
EXTRACTION_WORKERS=2
EXTRACTION_MAX_ATTEMPTS=3

# --- Limits ---------------------------------------------------------------------------
MAX_UPLOAD_MB=15
MAX_FILES_PER_UPLOAD=20
DB_POOL_SIZE=10
JWT_EXPIRE_MINUTES=480

# --- Optional -------------------------------------------------------------------------
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_VISION_MODEL=gpt-4.1
# OPENAI_TIMEOUT_SECONDS=60

# Python runtime hygiene (the code directory is read-only to the service).
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
